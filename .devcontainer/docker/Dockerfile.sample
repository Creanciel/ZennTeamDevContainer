FROM debian:trixie-slim AS base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    sudo && \
    rm -rf /var/lib/apt/lists/*

ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=development

RUN groupadd --gid "$USER_GID" "$USERNAME" && \
    useradd --uid "$USER_UID" --gid "$USER_GID" -m -s /bin/bash "$USERNAME" && \
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/$USERNAME" && \
    chmod 0440 "/etc/sudoers.d/$USERNAME"

USER "$USERNAME"
WORKDIR "/home/$USERNAME"

ENV PATH="/home/$USERNAME/.local/share/mise/shims:/home/$USERNAME/.local/bin:$PATH"

RUN curl -fsSL https://claude.ai/install.sh | bash


FROM base AS mise

RUN curl -fsSL https://mise.run | sh && \
    printf '# For mise (https://mise.jdx.dev/)\neval "$(~/.local/bin/mise activate bash)"\n' >> ~/.bash_aliases && \
    printf '\n# mise shims\nexport PATH="$HOME/.local/share/mise/shims:$PATH"\n' >> ~/.profile

FROM base AS default
